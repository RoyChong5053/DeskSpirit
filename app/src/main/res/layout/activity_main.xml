<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/bg">

    <!-- 上半屏：3D 音频驱动圆球 -->
    <com.roychong.deskspirit.render.SphereView
        android:id="@+id/sphere"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 右上角：设置入口（保持画面干净，只留一个小齿轮） -->
    <ImageButton
        android:id="@+id/btnSettings"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="8dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/cd_settings"
        android:padding="10dp"
        android:src="@drawable/ic_settings"
        android:alpha="0.6" />

    <!-- 下半屏：文字输出 -->
    <LinearLayout
        android:id="@+id/bottomPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="16dp"
        android:orientation="vertical"
        android:background="@drawable/bg_panel"
        android:padding="18dp">

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/status_listening"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:letterSpacing="0.04" />

        <TextView
            android:id="@+id/tvUser"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:maxLines="2"
            android:ellipsize="end" />

        <!-- KTV 字幕：可滚动，播放时逐字高亮 -->
        <ScrollView
            android:id="@+id/replyScroll"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginTop="8dp"
            android:overScrollMode="never"
            android:scrollbars="none">

            <TextView
                android:id="@+id/tvReply"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/reply_placeholder"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:lineSpacingExtra="4dp" />
        </ScrollView>
    </LinearLayout>

</FrameLayout>
